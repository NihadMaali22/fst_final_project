PORT=8080
HOST=0.0.0.0
DATABASE_URL=postgres://logs_user:logs_password@db:5432/logs_db
RETENTION_DAYS=30
AUTH_ENABLED=false
LOADGEN_API_KEY=
WRITE_FLUSH_INTERVAL_MS=250
WRITE_FLUSH_SIZE=6000
WRITE_CONCURRENCY=2
READ_POOL_SIZE=5
WRITE_POOL_SIZE=4
MAX_BUFFER_SIZE=60000
MAX_BUFFER_BYTES=104857600
# Bucket phasing: 'grid' (epoch-aligned, default) or 'since' (phased from the since arg).
# Both return exact counts; see README.
AGGREGATE_ALIGNMENT=grid
# Trigram index backfill on partitions that no longer take writes.
MESSAGE_INDEX_ENABLED=true
MESSAGE_INDEX_INTERVAL_MS=900000
MESSAGE_INDEX_MAX_PER_RUN=2
